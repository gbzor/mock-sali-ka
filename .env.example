# =============================================================================
# Sali Ka — Environment variables (example)
# =============================================================================
# This front-end mock app runs entirely client-side with local sample data and
# requires NO secrets to run. The variables below are provided as safe
# placeholders for when you wire the UI to a real backend.
#
# HOW TO USE:
#   1. Copy this file to `.env`      ->  cp .env.example .env
#   2. Replace the placeholder values with your own.
#   3. Never commit your real `.env` file (it is already in .gitignore).
#
# NOTE: With Vite, only variables prefixed with `VITE_` are exposed to the
# browser bundle. NEVER put private/server secrets in a VITE_-prefixed
# variable — anything shipped to the client is public.
# =============================================================================

# Base URL of your events API (public endpoint).
VITE_API_BASE_URL=https://api.example.com

# Public map tiles / geocoding key (client-side, domain-restricted key only).
VITE_MAP_PUBLIC_KEY=your_public_map_key_here
